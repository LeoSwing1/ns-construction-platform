# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Admin authentication — generate a random secret of at least 32 characters
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD"
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Purchase orders above this INR value require Super Admin approval (default: 100000)
PURCHASE_ORDER_SUPER_ADMIN_THRESHOLD="100000"

# Site
NEXT_PUBLIC_SITE_URL="https://your-domain.example"
NEXT_PUBLIC_WHATSAPP_NUMBER="918840751012"
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# Email (optional until configured)
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
ENQUIRY_NOTIFY_EMAIL=""

# Cloudinary (optional until configured)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Analytics (optional; configure consent and privacy requirements)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# WhatsApp Business Cloud API (optional; business enquiry alerts use an approved template)
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_NOTIFY_PHONE=""
WHATSAPP_TEMPLATE_NAME="new_enquiry_alert"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"

# Google Sheets lead sync (optional; deploy the Apps Script endpoint documented in README)
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_WEBHOOK_SECRET=""
